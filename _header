/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self' https:; script-src 'self' https://code.jquery.com https://unpkg.com; style-src 'self' https://unpkg.com 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' https: data:
  Strict-Transport-Security: max-age=31536000; includeSubDomains